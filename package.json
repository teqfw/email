{
  "name": "@teqfw/email",
  "version": "2.0.0",
  "type": "module",
  "description": "Email functionality for Tequila Framework (TeqFW) applications.",
  "license": "Apache-2.0",
  "author": "Alex Gusev <alex@teqfw.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/teqfw/email.git"
  },
  "bugs": {
    "url": "https://github.com/teqfw/email/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "email",
    "TeqFW",
    "Tequila Framework",
    "JavaScript",
    "template"
  ],
  "dependencies": {
    "@teqfw/cfg": "^2.1.0",
    "@teqfw/di": "^2.11.0",
    "@teqfw/log": "^2.1.2"
  },
  "files": [
    "skills/",
    "src/",
    ".env.example",
    "CHANGELOG.md",
    "jsconfig.json",
    "LICENSE",
    "README.md",
    "types.d.ts"
  ],
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  },
  "types": "types.d.ts",
  "exports": {
    ".": {
      "types": "./types.d.ts"
    }
  },
  "scripts": {
    "test": "node --test test/unit/Config.test.mjs test/unit/Back/*.test.mjs test/unit/Back/Act/*.test.mjs test/unit/Back/Transport/*.test.mjs test/unit/Back/Service/*.test.mjs test/unit/Back/Service/Load/A/*.test.mjs test/integration/*.test.mjs",
    "typecheck": "tsc -p jsconfig.json"
  },
  "teqfw": {
    "fw": {
      "di": {
        "namespaces": [
          {
            "prefix": "TeqFw_Email_",
            "path": "./src",
            "ext": ".mjs"
          }
        ]
      }
    }
  }
}
